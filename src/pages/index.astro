---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

let sortedNotes: any[] = [];
try {
	const allNotes = await getCollection('notes');
	sortedNotes = allNotes.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
} catch (e) {
	console.error('Failed to load notes collection:', e);
}

function formatDate(date: Date | string | number) {
	const safeDate = new Date(date);
	return isNaN(safeDate.getTime()) ? 'Unknown Date' : safeDate.toISOString().slice(0, 7).replace('-', '.');
}
---

<Layout title="xxbbm // 个人空间">
	<section id="about" class="section-block">
		<div class="thought-card">
			<strong>关于我 // About :</strong><br><br>
			📍 深圳 | AI 实践者 & 独立开发者<br><br>
			<strong>Background：</strong>非科班出身。两年独立电商经验，懂真实用户，重业务落地。<br>
			<strong>Focus：</strong>专注 AI 应用开发。热衷于将 Idea 快速工程化，折腾各类小工具、Agent 与实验性产品。<br>
			<strong>Workflow：</strong>深度依赖 Claude Code、Gemini 等工具。不拘泥于传统开发范式，核心是摸索“如何高效调度 AI 解决实际问题”。<br><br>
			处于持续试错与野蛮生长的阶段。不设终点，只造有趣且实用的东西。
		</div>
	</section>

	<section id="projects" class="section-block">
		<h2 class="section-label">实验 / Projects</h2>
		<ul class="project-list">
			<li class="project-item">
				<div class="project-header">
					<h3 class="project-title"><a href="https://github.com/xxbbm/MANUSCRIPT" target="_blank" rel="noopener noreferrer" class="hover-underline">Manuscript Frontend</a></h3>
					<span class="project-tags">UI/UX &middot; Minimalism</span>
				</div>
				<p class="project-summary">一个以极简主义为核心理念的写作与博客前端，剔除所有视觉噪音，专注于输入状态的“心流”体验与排版的负空间美学。线上演练地址可访问 <a href="https://xx.pwpxx.top" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: underline;">xx.pwpxx.top</a>。</p>
			</li>

			<li class="project-item">
				<div class="project-header">
					<h3 class="project-title"><a href="https://github.com/xxbbm/Plastic-Material-Testing" target="_blank" rel="noopener noreferrer" class="hover-underline">Polymer AI Identifier</a></h3>
					<span class="project-tags">Python &middot; Decision Tree</span>
				</div>
				<p class="project-summary">基于决策树与大模型辅助的工业塑料（ABS/PC/PP/PE）材质识别工具，旨在优化废弃物回收分拣流程的准确率。项目目前已在 GitHub 开源。</p>
			</li>

			<li class="project-item">
				<div class="project-header">
					<h3 class="project-title"><a href="https://github.com/xxbbm" target="_blank" rel="noopener noreferrer" class="hover-underline">Agent CLI Workspace</a></h3>
					<span class="project-tags">Node.js &middot; AI Tools</span>
				</div>
				<p class="project-summary">终端环境下的 AI 工作流配置方案，集成了 OpenClaw 与 Claude Code 等 CLI 工具，优化日常开发脚本调度与 API（DeepSeek/Gemini）管理。</p>
			</li>
		</ul>
	</section>

	<section id="notes" class="section-block">
		<h2 class="section-label">笔记 / Notes</h2>
		<div class="post-list">
			{sortedNotes.length > 0 ? sortedNotes.map(note => (
				<article class="post-item">
					<span class="post-meta">
						{formatDate(note.data.date)} &middot; {note.data.category}
					</span>
					<h3 class="post-title"><a href={`/notes/${note.slug}`} class="hover-underline">{note.data.title}</a></h3>
					{note.data.summary && <p class="post-summary truncate-summary">{note.data.summary}</p>}
				</article>
			)) : <p class="project-summary">No notes found.</p>}
		</div>
	</section>
</Layout>

<style>
	.thought-card { background-color: var(--card-bg); padding: 18px 20px; border-left: 2px solid var(--border-color); font-size: 12px; color: var(--text-muted); line-height: 1.6; }
	.project-list, .post-list { margin: 0; padding: 0; list-style: none; }
	.project-item, .post-item { margin-bottom: 35px; }
	.project-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
	.project-title, .post-title { font-size: 14px; font-weight: 500; color: var(--text-main); margin: 0 0 8px 0; letter-spacing: 0.01em; }
	.project-tags, .post-meta { font-size: 10px; font-family: "Times New Roman", Times, serif; font-style: italic; color: var(--text-faint); display: block; margin-bottom: 6px; }
	.project-summary, .post-summary { font-size: 12.5px; color: var(--text-muted); margin: 0; text-align: justify; }
</style>
